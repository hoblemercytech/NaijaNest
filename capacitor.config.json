{
  "appId": "com.budgetsave.app",
  "appName": "BudgetSave",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 2000,
      "backgroundColor": "#0B3D2C",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B3D2C"
    }
  }
}
